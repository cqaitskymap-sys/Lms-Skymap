rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().role;
    }

    function isActive() {
      return isSignedIn() && userDocExists() && userDoc().isActive == true;
    }

    function hasRole(roles) {
      return isActive() && role() in roles;
    }

    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfEmployee() {
      return isActive() && userDoc().employeeId != null;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ─── Auth / RBAC config ───────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwner(userId) ||
        (userDocExists() && isActive() &&
          hasRole(['super_admin', 'hr', 'qa', 'department_head']))
      );

      // First-login bootstrap — cannot self-assign elevated roles
      allow create: if isSignedIn() && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['employee']
        && request.resource.data.isActive == true;

      // Self: profile fields only (never role / isActive)
      allow update: if hasRole(['super_admin', 'hr'])
        || (isOwner(userId) && onlyUpdating([
          'displayName', 'phone', 'photoURL', 'digitalSignatureUrl',
          'updatedAt', 'lastLoginAt', 'lastLoginIp'
        ]))
        || (isOwner(userId)
          && onlyUpdating(['mustChangePassword', 'passwordChangedAt', 'updatedAt'])
          && request.resource.data.mustChangePassword == false);

      allow delete: if isSuperAdmin();
    }

    match /counters/{id} {
      allow read, write: if false; // Admin SDK only (employee code allocation)
    }

    match /company_policies/{id} {
      allow read: if isActive();
      allow write: if hasRole(['super_admin', 'hr']);
    }

    match /policy_acceptances/{id} {
      allow read: if isActive() && (
        resource.data.userId == request.auth.uid ||
        hasRole(['super_admin', 'hr', 'qa'])
      );
      allow create: if false; // Admin SDK / onboarding API only
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /roles/{id} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    match /permissions/{id} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    // Lockouts — Admin SDK / API only (no client access)
    match /login_lockouts/{id} {
      allow read, write: if false;
    }

    match /activity_logs/{id} {
      allow read: if isActive() && (
        resource.data.userId == request.auth.uid ||
        hasRole(['super_admin', 'hr', 'qa'])
      );
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ─── Organization ─────────────────────────────────────────────────
    match /departments/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'hr']);
      allow delete: if isSuperAdmin();
    }

    match /employees/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        (isSelfEmployee() && resource.data.id == userDoc().employeeId)
      );
      allow create, update: if hasRole(['super_admin', 'hr', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    // ─── Induction ────────────────────────────────────────────────────
    match /induction_modules/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'hr']);
      allow delete: if isSuperAdmin();
    }

    match /induction_assignments/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == request.auth.uid ||
        (userDoc().keys().hasAny(['employeeId']) &&
          resource.data.employeeId == userDoc().employeeId)
      );
      allow create: if hasRole(['super_admin', 'hr']);
      allow update: if hasRole(['super_admin', 'hr']) ||
        resource.data.employeeId == request.auth.uid ||
        (userDoc().keys().hasAny(['employeeId']) &&
          resource.data.employeeId == userDoc().employeeId);
      allow delete: if isSuperAdmin();
    }

    // ─── JD & TNI ─────────────────────────────────────────────────────
    match /job_descriptions/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'department_head', 'hr', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /training_need_identifications/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'department_head', 'hr', 'qa']);
      allow delete: if isSuperAdmin();
    }

    // ─── SOPs ─────────────────────────────────────────────────────────
    match /sops/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /sop_versions/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /sop_views/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'qa', 'hr', 'department_head']) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /sop_acknowledgements/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'qa', 'hr', 'department_head']) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ─── Training ─────────────────────────────────────────────────────
    match /trainers/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'hr', 'department_head', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /training_sessions/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'department_head', 'trainer']);
      allow delete: if isSuperAdmin();

      match /attendance/{empId} {
        allow read: if isActive();
        allow create, update: if hasRole(['super_admin', 'department_head', 'trainer']);
        allow delete: if isSuperAdmin();
      }
    }

    match /training_assignments/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create: if hasRole(['super_admin', 'department_head', 'qa']);
      allow update: if hasRole(['super_admin', 'department_head', 'trainer', 'qa']) ||
        resource.data.employeeId == userDoc().employeeId;
      allow delete: if isSuperAdmin();
    }

    match /training_matrix/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }

    // ─── Assessments ──────────────────────────────────────────────────
    match /question_banks/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa', 'hr']);
      allow delete: if isSuperAdmin();
    }

    match /questions/{id} {
      // Active users need to read questions to take exams (answers sanitized in attempt payload)
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa', 'hr']);
      allow delete: if isSuperAdmin();
    }

    match /exams/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa', 'hr']);
      allow delete: if isSuperAdmin();
    }

    match /assessment_attempts/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId ||
        resource.data.employeeId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );

      allow create: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.employeeId == request.auth.uid ||
        (userDoc().keys().hasAny(['employeeId']) &&
          request.resource.data.employeeId == userDoc().employeeId)
      );

      allow update: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.employeeId == request.auth.uid ||
        (userDoc().keys().hasAny(['employeeId']) &&
          resource.data.employeeId == userDoc().employeeId)
      );

      allow delete: if isSuperAdmin();
    }

    match /exam_results/{id} {
      // Leaderboard / analytics need broad read inside the LMS
      allow read: if isActive();
      allow create: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.employeeId == request.auth.uid ||
        (userDoc().keys().hasAny(['employeeId']) &&
          request.resource.data.employeeId == userDoc().employeeId)
      );
      allow update: if hasRole(['super_admin', 'qa', 'hr']);
      allow delete: if isSuperAdmin();
    }

    // Aggregated leaderboard docs: exam_leaderboards/{examId}
    match /exam_leaderboards/{examId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isSuperAdmin();
    }

    // ─── Certificates / notifications / audit ─────────────────────────
    match /certificates/{id} {
      // Public read enables QR verification without login
      allow read: if true;
      allow create: if hasRole(['super_admin', 'qa', 'hr']);
      allow update: if hasRole(['super_admin', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /notifications/{id} {
      allow read: if isActive() && resource.data.userId == request.auth.uid;
      allow update: if isActive() && resource.data.userId == request.auth.uid
        && onlyUpdating(['isRead', 'readAt', 'updatedAt']);
      allow create: if hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']);
      allow delete: if isSuperAdmin()
        || (isActive() && resource.data.userId == request.auth.uid);
    }

    match /audit_logs/{id} {
      allow read: if hasRole(['super_admin', 'hr', 'qa']);
      allow create: if false; // Admin SDK / API only for integrity
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /lifecycle_events/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create: if isActive();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /lifecycle_approvals/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create: if hasRole(['super_admin', 'hr', 'department_head', 'qa']);
      allow update: if hasRole(['super_admin', 'hr', 'department_head', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /reports/{id} {
      allow read: if isActive() && (
        resource.data.requestedBy == request.auth.uid ||
        hasRole(['super_admin', 'hr', 'qa'])
      );
      allow create: if hasRole(['super_admin', 'hr', 'qa', 'department_head']);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /report_rollups/{id} {
      allow read: if isActive() && hasRole(['super_admin', 'hr', 'qa', 'department_head']);
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().role;
    }

    function isActive() {
      return isSignedIn() && userDocExists() && userDoc().isActive == true;
    }

    function hasRole(roles) {
      return isActive() && role() in roles;
    }

    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfEmployee() {
      return isActive() && userDoc().employeeId != null;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function currentNum(field) {
      return field in resource.data && resource.data[field] is number
        ? resource.data[field]
        : 0;
    }

    // JS clients often store whole numbers as doubles; increment() is a number either way.
    function isIncrement(field) {
      return request.resource.data[field] is number
        && request.resource.data[field] == currentNum(field) + 1;
    }

    // Any active user may bump SOP read/ack counters, but cannot change SOP content.
    // Transform-only writes (FieldValue.increment) can report empty affectedKeys.
    function isSopCounterBump() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isActive()
        && changed.hasOnly(['viewCount', 'acknowledgementCount'])
        && (!changed.hasAny(['viewCount']) || isIncrement('viewCount'))
        && (!changed.hasAny(['acknowledgementCount']) || isIncrement('acknowledgementCount'));
    }

    // ─── Auth / RBAC config ───────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwner(userId) ||
        (userDocExists() && isActive() &&
          hasRole(['super_admin', 'hr', 'qa', 'department_head']))
      );

      // First-login bootstrap — cannot self-assign elevated roles
      allow create: if isSignedIn() && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['employee']
        && request.resource.data.isActive == true;

      // Self: profile fields only (never role / isActive)
      allow update: if hasRole(['super_admin', 'hr'])
        || (isOwner(userId) && onlyUpdating([
          'displayName', 'phone', 'photoURL', 'digitalSignatureUrl',
          'updatedAt', 'lastLoginAt', 'lastLoginIp'
        ]))
        || (isOwner(userId)
          && onlyUpdating(['mustChangePassword', 'passwordChangedAt', 'updatedAt'])
          && request.resource.data.mustChangePassword == false);

      allow delete: if isSuperAdmin();
    }

    match /counters/{id} {
      allow read, write: if false; // Admin SDK only (employee code allocation)
    }

    match /company_policies/{id} {
      allow read: if isActive();
      allow write: if hasRole(['super_admin', 'hr']);
    }

    match /policy_acceptances/{id} {
      allow read: if isActive() && (
        resource.data.userId == request.auth.uid ||
        hasRole(['super_admin', 'hr', 'qa'])
      );
      allow create: if false; // Admin SDK / onboarding API only
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /roles/{id} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    match /permissions/{id} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    // Lockouts — Admin SDK / API only (no client access)
    match /login_lockouts/{id} {
      allow read, write: if false;
    }

    match /activity_logs/{id} {
      allow read: if isActive() && (
        resource.data.userId == request.auth.uid ||
        hasRole(['super_admin', 'hr', 'qa'])
      );
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ─── Organization ─────────────────────────────────────────────────
    match /departments/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'hr']);
      allow delete: if isSuperAdmin();
    }

    match /employees/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        (isSelfEmployee() && (
          id == userDoc().employeeId ||
          ('id' in resource.data && resource.data.id == userDoc().employeeId)
        ))
      );
      allow create, update: if hasRole(['super_admin', 'hr']);
      allow delete: if isSuperAdmin();
    }

    // ─── Induction ────────────────────────────────────────────────────
    match /induction_modules/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'hr']);
      allow delete: if isSuperAdmin();
    }

    match /induction_assignments/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        (userDoc().keys().hasAny(['employeeId']) &&
          resource.data.employeeId == userDoc().employeeId)
      );
      allow create: if hasRole(['super_admin', 'hr']);
      allow update: if hasRole(['super_admin', 'hr']) ||
        (
          isActive()
          && userDoc().keys().hasAny(['employeeId'])
          && resource.data.employeeId == userDoc().employeeId
          && onlyUpdating([
            'documentsViewed', 'progressPercent', 'status',
            'startedAt', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.status in [
            'assigned', 'not_started', 'in_progress', 'assessment_pending'
          ]
        );
      allow delete: if isSuperAdmin();
    }

    // ─── JD & TNI ─────────────────────────────────────────────────────
    match /job_descriptions/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        (userDoc().keys().hasAny(['employeeId']) &&
          resource.data.employeeId == userDoc().employeeId)
      );
      allow create, update: if hasRole(['super_admin', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    match /training_need_identifications/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        (userDoc().keys().hasAny(['employeeId']) &&
          resource.data.employeeId == userDoc().employeeId)
      );
      allow create, update: if hasRole(['super_admin', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    // ─── SOPs ─────────────────────────────────────────────────────────
    match /sops/{id} {
      allow read: if isActive();
      allow create: if hasRole(['super_admin', 'qa']);
      allow update: if hasRole(['super_admin', 'qa']) || isSopCounterBump();
      allow delete: if isSuperAdmin();
    }

    match /sop_versions/{id} {
      allow read: if isActive();
      allow create: if hasRole(['super_admin', 'qa']);
      allow update: if hasRole(['super_admin', 'qa']) || isSopCounterBump();
      allow delete: if isSuperAdmin();
    }

    match /sop_views/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'qa', 'hr', 'department_head']) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /sop_acknowledgements/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'qa', 'hr', 'department_head']) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /sop_reading_progress/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'qa', 'hr', 'department_head']) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isActive()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSuperAdmin();
    }

    // ─── Training ─────────────────────────────────────────────────────
    match /trainers/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'hr', 'department_head', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /training_sessions/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'department_head', 'trainer']);
      allow delete: if isSuperAdmin();

      match /attendance/{empId} {
        allow read: if isActive();
        allow create, update: if hasRole(['super_admin', 'department_head', 'trainer']);
        allow delete: if isSuperAdmin();
      }
    }

    match /training_assignments/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create: if hasRole(['super_admin', 'department_head']);
      allow update: if hasRole(['super_admin', 'department_head', 'trainer', 'qa'])
        || (
          isActive()
          && userDoc().keys().hasAny(['employeeId'])
          && resource.data.employeeId == userDoc().employeeId
          && onlyUpdating(['status', 'startedAt', 'trainingCompletedAt', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in [
            'assigned', 'in_progress', 'training_completed', 'assessment_pending'
          ]
        );
      allow delete: if isSuperAdmin();
    }

    match /training_matrix/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }

    // ─── On Job Training ──────────────────────────────────────────────
    match /ojt_topics/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    match /ojt_plans/{id} {
      // Unfiltered list queries (planner/matrix) require a resource-independent read rule.
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    match /ojt_assignments/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create: if hasRole(['super_admin', 'qa', 'department_head']);
      allow update: if hasRole(['super_admin', 'qa', 'department_head', 'trainer'])
        || (
          isActive()
          && userDoc().keys().hasAny(['employeeId'])
          && resource.data.employeeId == userDoc().employeeId
          && onlyUpdating(['acknowledgement', 'status', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in [
            'trainer_completed', 'employee_acknowledged', 'verification_pending',
            'qa_pending', 'completed'
          ]
        );
      allow delete: if isSuperAdmin();
    }

    match /ojt_evaluation_criteria/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /ojt_settings/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /ojt_form_documents/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    // ─── Assessments ──────────────────────────────────────────────────
    match /question_banks/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa', 'hr', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    match /questions/{id} {
      // Answer keys stay staff-only. Exam assembly/scoring uses Admin SDK.
      allow read: if hasRole(['super_admin', 'qa', 'hr', 'department_head', 'trainer']);
      allow create, update: if hasRole(['super_admin', 'qa', 'hr', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    match /exams/{id} {
      allow read: if isActive();
      allow create, update: if hasRole(['super_admin', 'qa', 'hr', 'department_head']);
      allow delete: if isSuperAdmin();
    }

    match /assessment_attempts/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId ||
        resource.data.employeeId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );

      // Start/submit/score via Admin SDK APIs only — clients may autosave drafts.
      allow create: if false;

      allow update: if isActive()
        && (
          resource.data.createdBy == request.auth.uid ||
          resource.data.employeeId == request.auth.uid ||
          (userDoc().keys().hasAny(['employeeId']) &&
            resource.data.employeeId == userDoc().employeeId)
        )
        && resource.data.status == 'in_progress'
        && request.resource.data.status == 'in_progress'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answersDraft', 'lastSavedAt', 'updatedAt', 'updatedBy']);

      allow delete: if isSuperAdmin();
    }

    match /exam_results/{id} {
      // Scores/ranks only (no question keys). Written via Admin SDK submit API.
      allow read: if isActive();
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }

    // Aggregated leaderboard docs: exam_leaderboards/{examId}
    match /exam_leaderboards/{examId} {
      allow read: if isActive();
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }

    // ─── Certificates / notifications / audit ─────────────────────────
    match /certificates/{id} {
      // Public verification uses /api/certificates/verify (Admin SDK) — not open reads.
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create: if false; // Admin SDK issue API only
      allow update: if hasRole(['super_admin', 'qa']);
      allow delete: if isSuperAdmin();
    }

    match /notifications/{id} {
      allow read: if isActive() && resource.data.userId == request.auth.uid;
      allow update: if isActive() && resource.data.userId == request.auth.uid
        && onlyUpdating(['isRead', 'readAt', 'updatedAt']);
      allow create: if hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer'])
        || (isActive() && request.resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin()
        || (isActive() && resource.data.userId == request.auth.uid);
    }

    match /audit_logs/{id} {
      allow read: if hasRole(['super_admin', 'hr', 'qa']);
      allow create: if false; // Admin SDK / API only for integrity
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /lifecycle_events/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head', 'trainer']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create: if hasRole(['super_admin', 'hr']);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /lifecycle_approvals/{id} {
      allow read: if isActive() && (
        hasRole(['super_admin', 'hr', 'qa', 'department_head']) ||
        resource.data.employeeId == userDoc().employeeId
      );
      allow create: if hasRole(['super_admin', 'hr', 'department_head', 'qa']);
      allow update: if hasRole(['super_admin', 'hr']);
      allow delete: if isSuperAdmin();
    }

    match /reports/{id} {
      allow read: if isActive() && (
        resource.data.requestedBy == request.auth.uid ||
        hasRole(['super_admin', 'hr', 'qa'])
      );
      allow create: if hasRole(['super_admin', 'hr', 'qa', 'department_head']);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /report_rollups/{id} {
      allow read: if isActive() && hasRole(['super_admin', 'hr', 'qa', 'department_head']);
      allow create, update: if false;
      allow delete: if isSuperAdmin();
    }
  }
}
